#include <dt-bindings/zmk/matrix_transform.h>

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;

        zephyr,display = &clavis_st7789;
        zmk,display-led = &lcd_bl;
    };

    /*
     * ========================================================
     * KSCAN COMPUESTO
     * ========================================================
     *
     * Filas 0–2 = nueve teclas Hall.
     * Fila 3    = botones de los dos encoders.
     */

    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";

        rows = <4>;
        columns = <3>;

        wakeup-source;

        hall_keys {
            kscan = <&hall_mock>;
        };

        encoder_buttons {
            kscan = <&encoder_button_kscan>;
            row-offset = <3>;
        };
    };

    /*
     * Temporal hasta portar HAL403 + CD74HC4067 a ZMK.
     */
    hall_mock: hall_mock {
        compatible = "zmk,kscan-mock";

        rows = <3>;
        columns = <3>;

        events = <>;
    };

    /*
     * Botones SW:
     *
     * EC0 SW = D4  = P0.04
     * EC1 SW = D17 = P1.03
     */

    encoder_button_kscan: encoder_button_kscan {
        compatible = "zmk,kscan-gpio-direct";

        wakeup-source;

        debounce-press-ms = <5>;
        debounce-release-ms = <5>;

        input-gpios
            = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    /*
     * ========================================================
     * POSICIONES LÓGICAS
     * ========================================================
     *
     * 0–8  = nueve teclas Hall.
     * 9    = botón EC0.
     * 10   = botón EC1.
     */

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";

        rows = <4>;
        columns = <3>;

        map = <
            RC(0, 0) RC(0, 1) RC(0, 2)
            RC(1, 0) RC(1, 1) RC(1, 2)
            RC(2, 0) RC(2, 1) RC(2, 2)
            RC(3, 0) RC(3, 1)
        >;
    };

    /*
     * ========================================================
     * ENCODER 0 — RGB
     * ========================================================
     *
     * A  = D1 = P0.03
     * B  = D2 = P0.28
     * SW = D4 = P0.04
     */

    encoder0: encoder0 {
        compatible = "alps,ec11";

        a-gpios = <&gpio0 3
            (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;

        b-gpios = <&gpio0 28
            (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;

        steps = <80>;

        status = "okay";
    };

    /*
     * ========================================================
     * ENCODER 1 — VOLUMEN
     * ========================================================
     *
     * A  = D12 = P0.19
     * B  = D13 = P1.01
     * SW = D17 = P1.03
     */

    encoder1: encoder1 {
        compatible = "alps,ec11";

        a-gpios = <&gpio0 19
            (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;

        b-gpios = <&gpio1 1
            (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;

        steps = <80>;

        status = "okay";
    };

    /*
     * El orden aquí controla el orden de sensor-bindings:
     *
     * sensor 0 = EC0
     * sensor 1 = EC1
     */

    clavis_sensors: clavis_sensors {
        compatible = "zmk,keymap-sensors";

        sensors = <&encoder0 &encoder1>;

        triggers-per-rotation = <80>;
    };

    /*
     * ========================================================
     * BACKLIGHT DE LA ST7789
     * ========================================================
     *
     * Se conserva exactamente como GPIO.
     * No estamos implementando PWM ni control variable.
     */

    lcd_backlight: lcd_backlight {
        compatible = "gpio-leds";

        lcd_bl: lcd_bl {
            gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
            label = "ST7789 Backlight";
        };
    };

    /*
     * ========================================================
     * ST7789 240 × 240
     * ========================================================
     */

    clavis_mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";

        spi-dev = <&xiao_spi>;

        dc-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;

        write-only;

        #address-cells = <1>;
        #size-cells = <0>;

        clavis_st7789: st7789v@0 {
            compatible = "sitronix,st7789v";

            reg = <0>;

            mipi-max-frequency = <4000000>;
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";

            width = <240>;
            height = <240>;

            /*
             * Rotación 180° con la ventana correcta de memoria
             * para este panel 240 × 240.
             */
            x-offset = <0>;
            y-offset = <80>;

            vcom = <0x19>;
            gctrl = <0x35>;
            vrhs = <0x12>;
            vdvs = <0x20>;

            mdac = <0xC0>;

            lcm = <0x2c>;
            colmod = <0x55>;
            gamma = <0x01>;

            porch-param = [0c 0c 00 33 33];
            cmd2en-param = [5a 69 02 01];
            pwctrl1-param = [a4 a1];

            pvgam-param = [
                d0 04 0d 11 13 2b 3f
                54 4c 18 0d 0b 1f 23
            ];

            nvgam-param = [
                d0 04 0c 11 13 2c 3f
                44 51 2f 1f 1f 20 23
            ];

            ram-param = [00 f0];
            rgb-param = [cd 08 14];

            status = "okay";
        };
    };
};

/*
 * SPI de la pantalla:
 *
 * MOSI = D10 = P1.15
 * SCLK = D8  = P1.13
 * CS   = D19 = P1.07
 */

&xiao_spi {
    status = "okay";

    cs-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
};

/*
 * D14/P0.09 y D15/P0.10 se usan como GPIO,
 * no como NFC.
 */

&uicr {
    nfct-pins-as-gpios;
};