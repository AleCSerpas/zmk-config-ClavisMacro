#include <behaviors.dtsi>

#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define LAYER_BASE 0
#define LAYER_RGB  1

/ {
    behaviors {
        /* EC0 on Base: next/previous RGB effect. */
        rgb_effect_encoder: rgb_effect_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;

            bindings =
                <&rgb_ug RGB_EFF>,
                <&rgb_ug RGB_EFR>;
        };

        /* EC0 on RGB layer: brightness up/down. */
        rgb_brightness_encoder: rgb_brightness_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;

            bindings =
                <&rgb_ug RGB_BRI>,
                <&rgb_ug RGB_BRD>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Base layer
         *
         * EC0 rotation = RGB effects
         * EC0 press    = toggle RGB control layer
         * EC1 rotation = volume
         * EC1 press    = mute
         */
        base_layer {
            display-name = "Base";

            bindings = <
                &kp N1       &kp N2       &kp N3
                &kp N4       &kp N5       &kp N6
                &kp N7       &kp N8       &kp N9

                &tog LAYER_RGB  &kp C_MUTE
            >;

            sensor-bindings = <
                &rgb_effect_encoder
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        /*
         * RGB layer
         *
         * EC0 rotation = RGB brightness
         * EC0 press    = return to Base
         * EC1 rotation = volume
         * EC1 press    = mute
         */
        rgb_layer {
            display-name = "RGB";

            bindings = <
                &trans          &trans       &trans
                &trans          &trans       &trans
                &trans          &trans       &trans

                &tog LAYER_RGB  &kp C_MUTE
            >;

            sensor-bindings = <
                &rgb_brightness_encoder
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
    };
};
