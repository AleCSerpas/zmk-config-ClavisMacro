#include <behaviors.dtsi>

#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/*
 * Capas de ClavisMacro.
 */
#define LAYER_BASE 0
#define LAYER_RGB  1

/ {
    behaviors {
        /*
         * EC1 en la capa Base:
         *
         * Horario     = siguiente efecto RGB
         * Antihorario = efecto RGB anterior
         */
        rgb_effect_encoder: rgb_effect_encoder {
            compatible = "zmk,behavior-sensor-rotate";

            #sensor-binding-cells = <0>;

            bindings =
                <&rgb_ug RGB_EFF>,
                <&rgb_ug RGB_EFR>;
        };

        /*
         * EC1 en la capa RGB:
         *
         * Horario     = aumentar brillo
         * Antihorario = disminuir brillo
         */
        rgb_brightness_encoder: rgb_brightness_encoder {
            compatible = "zmk,behavior-sensor-rotate";

            #sensor-binding-cells = <0>;

            bindings =
                <&rgb_ug RGB_BRI>,
                <&rgb_ug RGB_BRD>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * ====================================================
         * CAPA 0 — BASE
         * ====================================================
         *
         * EC0:
         *   Giro   = volumen
         *   Botón  = mute
         *
         * EC1:
         *   Giro   = cambiar efecto RGB
         *   Botón  = cambiar a la capa RGB
         */
        base_layer {
            display-name = "Base";

            bindings = <
                &kp N1       &kp N2       &kp N3
                &kp N4       &kp N5       &kp N6
                &kp N7       &kp N8       &kp N9

                &kp C_MUTE   &tog LAYER_RGB
            >;

            /*
             * El orden debe coincidir con el overlay:
             *
             * 1. EC0
             * 2. EC1
             */
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &rgb_effect_encoder
            >;
        };

        /*
         * ====================================================
         * CAPA 1 — RGB
         * ====================================================
         *
         * Las nueve teclas conservan temporalmente su función
         * de la capa Base mediante &trans.
         *
         * EC0:
         *   Giro   = volumen
         *   Botón  = mute
         *
         * EC1:
         *   Giro   = ajustar brillo RGB
         *   Botón  = regresar a la capa Base
         */
        rgb_layer {
            display-name = "RGB";

            bindings = <
                &trans         &trans         &trans
                &trans         &trans         &trans
                &trans         &trans         &trans

                &trans         &tog LAYER_RGB
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &rgb_brightness_encoder
            >;
        };
    };
};