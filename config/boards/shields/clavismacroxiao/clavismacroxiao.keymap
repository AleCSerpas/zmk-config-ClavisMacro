#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define LAYER_BASE 0
#define LAYER_RGB  1

/ {
    behaviors {
        /* Custom engine behavior. Uses the same RGB_* commands as ZMK. */
        cl_rgb: clavis_rgb {
            compatible = "zmk,behavior-clavis-rgb";
            #binding-cells = <2>;
            display-name = "Clavis RGB";
        };

        rgb_effect_encoder: rgb_effect_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&cl_rgb RGB_EFF>, <&cl_rgb RGB_EFR>;
        };

        rgb_brightness_encoder: rgb_brightness_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&cl_rgb RGB_BRI>, <&cl_rgb RGB_BRD>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";

            bindings = <
                &kp N1 &kp N2 &kp N3
                &kp N4 &kp N5 &kp N6
                &kp N7 &kp N8 &kp N9
                &tog LAYER_RGB &kp C_MUTE
            >;

            sensor-bindings = <
                &rgb_effect_encoder
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        rgb_layer {
            display-name = "RGB";

            bindings = <
                &trans &trans &trans
                &trans &trans &trans
                &trans &trans &trans
                &tog LAYER_RGB &trans
            >;

            sensor-bindings = <
                &rgb_brightness_encoder
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
    };
};
