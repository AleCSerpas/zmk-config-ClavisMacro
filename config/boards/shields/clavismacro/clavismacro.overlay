#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /*
     * Combina:
     * - Matriz 3x3
     * - Botón directo del encoder
     *
     * Resultado lógico:
     *
     * Row 0: Key 0  Key 1  Key 2
     * Row 1: Key 3  Key 4  Key 5
     * Row 2: Key 6  Key 7  Key 8
     * Row 3: Encoder button
     */
    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";

        rows = <4>;
        columns = <3>;

        wakeup-source;

        matrix {
            kscan = <&matrix_kscan>;
        };

        encoder_button {
            kscan = <&encoder_button_kscan>;
            row-offset = <3>;
        };
    };

    /*
     * Matriz principal 3x3
     *
     * Rows:
     * D3, D16, D15
     *
     * Columns:
     * D9, D8, D2
     */
    matrix_kscan: matrix_kscan {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "row2col";
        wakeup-source;

        row-gpios
            = <&pro_micro 3 GPIO_ACTIVE_HIGH>
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>
            ;

        col-gpios
            = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    /*
     * Botón del encoder:
     * D10 conectado a GND cuando se presiona
     */
    encoder_button_kscan: encoder_button_kscan {
        compatible = "zmk,kscan-gpio-direct";

        wakeup-source;

        input-gpios = <
            &pro_micro 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)
        >;
    };

    /*
     * Ahora hay 10 posiciones lógicas:
     * 9 teclas + botón del encoder
     */
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";

        rows = <4>;
        columns = <3>;

        map = <
            RC(0, 0) RC(0, 1) RC(0, 2)
            RC(1, 0) RC(1, 1) RC(1, 2)
            RC(2, 0) RC(2, 1) RC(2, 2)
            RC(3, 0)
        >;
    };

    /*
     * Encoder EC11
     *
     * A = D14
     * B = D11
     */
    encoder0: encoder0 {
        compatible = "alps,ec11";

        a-gpios = <
            &pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)
        >;

        b-gpios = <
            &pro_micro 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)
        >;

        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";

        sensors = <&encoder0>;

        /*
         * Muchos EC11 generan aproximadamente
         * 20 detents por vuelta.
         */
        triggers-per-rotation = <20>;
    };
};