#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define BT   1

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * LAYER 0 — HARDWARE TEST / BASE
         *
         * ┌─────┬─────┬─────┐
         * │  1  │  2  │  3  │
         * ├─────┼─────┼─────┤
         * │  4  │  5  │  6  │
         * ├─────┼─────┼─────┤
         * │  7  │  8  │  9  │
         * └─────┴─────┴─────┘
         *
         * Encoder button: go to Bluetooth layer
         * Encoder rotation: volume up/down
         *
         * Numbers are used temporarily because every key gives
         * visible output in Windows and in an iPhone text field.
         */
        base_layer {
            display-name = "Base";

            bindings = <
                &kp N1    &kp N2    &kp N3
                &kp N4    &kp N5    &kp N6
                &kp N7    &kp N8    &kp N9

                &to BT
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        /*
         * LAYER 1 — BLUETOOTH
         *
         * ┌────────┬────────┬────────┐
         * │ BT 0   │ BT 1   │ BT 2   │
         * ├────────┼────────┼────────┤
         * │ Prev   │ Clear  │ Next   │
         * ├────────┼────────┼────────┤
         * │ BT 3   │ BT 4   │ Base   │
         * └────────┴────────┴────────┘
         *
         * Encoder button: return to Base
         * Encoder rotation: volume up/down
         */
        bluetooth_layer {
            display-name = "Bluetooth";

            bindings = <
                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2
                &bt BT_PRV      &bt BT_CLR      &bt BT_NXT
                &bt BT_SEL 3    &bt BT_SEL 4    &to BASE

                &to BASE
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
    };
};
