#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define BT   1

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * LAYER 0 — NAVIGATION
         *
         * ┌─────────────┬─────────────┬─────────────┐
         * │ PrintScreen │ Scroll Lock │ Pause/Break │
         * ├─────────────┼─────────────┼─────────────┤
         * │ Insert      │ Home        │ Page Up     │
         * ├─────────────┼─────────────┼─────────────┤
         * │ Delete      │ End         │ Page Down   │
         * └─────────────┴─────────────┴─────────────┘
         *
         * Encoder button → Bluetooth layer
         * Encoder rotation → Volume
         */
        base_layer {
            display-name = "Navigation";

            bindings = <
                &kp PRINTSCREEN    &kp SCROLLLOCK    &kp PAUSE_BREAK
                &kp INSERT         &kp HOME          &kp PAGE_UP
                &kp DELETE         &kp END           &kp PAGE_DOWN

                &to BT
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        /*
         * LAYER 1 — BLUETOOTH
         *
         * ┌──────────┬──────────┬──────────┐
         * │ BT 0     │ BT 1     │ BT 2     │
         * ├──────────┼──────────┼──────────┤
         * │ BT Prev  │ BT Clear │ BT Next  │
         * ├──────────┼──────────┼──────────┤
         * │ BT 3     │ BT 4     │ Base     │
         * └──────────┴──────────┴──────────┘
         *
         * Encoder button → Base layer
         * Encoder rotation → Volume
         */
        bluetooth_layer {
            display-name = "Bluetooth";

            bindings = <
                &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2
                &bt BT_PRV         &bt BT_CLR         &bt BT_NXT
                &bt BT_SEL 3       &bt BT_SEL 4       &to BASE

                &to BASE
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
    };
};