#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE  0
#define MEDIA 1
#define EXTRA 2

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * LAYER 0 — NAVIGATION
         *
         * ┌─────────────┬─────────────┬─────────────┐
         * │ PrintScreen │ Scroll Lock │ Pause/Break │
         * ├─────────────┼─────────────┼─────────────┤
         * │ Insert      │ Home        │ Page Up     │
         * ├─────────────┼─────────────┼─────────────┤
         * │ Delete      │ End         │ Page Down   │
         * └─────────────┴─────────────┴─────────────┘
         *
         * Encoder button: switch to Media layer
         * Encoder rotation: volume
         */
        base_layer {
            display-name = "Navigation";

            bindings = <
                &kp PRINTSCREEN    &kp SCROLLLOCK    &kp PAUSE_BREAK
                &kp INSERT         &kp HOME          &kp PAGE_UP
                &kp DELETE         &kp END           &kp PAGE_DOWN

                &to MEDIA
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        /*
         * LAYER 1 — MEDIA
         *
         * ┌──────────┬────────────┬──────────┐
         * │ Previous │ Play/Pause │ Next     │
         * ├──────────┼────────────┼──────────┤
         * │ Vol Down │ Mute       │ Vol Up   │
         * ├──────────┼────────────┼──────────┤
         * │ Stop     │ Base       │ Extra    │
         * └──────────┴────────────┴──────────┘
         *
         * Encoder button: mute
         * Encoder rotation: volume
         */
        media_layer {
            display-name = "Media";

            bindings = <
                &kp C_PREV         &kp C_PLAY_PAUSE    &kp C_NEXT
                &kp C_VOL_DN       &kp C_MUTE          &kp C_VOL_UP
                &kp C_STOP         &to BASE            &to EXTRA

                &kp C_MUTE
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        /*
         * LAYER 2 — BLUETOOTH / SYSTEM
         *
         * ┌──────────┬──────────┬──────────┐
         * │ BT 0     │ BT 1     │ BT 2     │
         * ├──────────┼──────────┼──────────┤
         * │ BT Prev  │ BT Clear │ BT Next  │
         * ├──────────┼──────────┼──────────┤
         * │ Bootload │ Reset    │ Base     │
         * └──────────┴──────────┴──────────┘
         *
         * Encoder button: return to Base
         * Encoder rotation: volume
         */
        extra_layer {
            display-name = "Bluetooth";

            bindings = <
                &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2
                &bt BT_PRV         &bt BT_CLR         &bt BT_NXT
                &bootloader        &sys_reset         &to BASE

                &to BASE
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
    };
};