# ============================================================
# ClavisMacro — ZMK configuration
# Controller: nice!nano v2 / SuperMini nRF52840
# ============================================================

# Rotary encoder EC11
CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

# USB keyboard support
CONFIG_ZMK_USB=y

# Bluetooth keyboard support
CONFIG_ZMK_BLE=y

# Save Bluetooth pairings and keyboard settings
CONFIG_SETTINGS=y

# Battery reporting
CONFIG_ZMK_BATTERY_REPORTING=y

# Sleep after inactivity to save battery
CONFIG_ZMK_SLEEP=y
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=900000

# Keyboard name shown over Bluetooth
CONFIG_ZMK_KEYBOARD_NAME="ClavisMacro"